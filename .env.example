# PeopleGraph — copy to .env for local use (this file is safe to commit)

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dummy-neo4j-password

PORT=8010
FLASK_DEBUG=true
APP_PUBLIC_URL=http://localhost:8010
DOMAIN=localhost
TRUST_PROXY=false

# Generate strong keys (required when FLASK_DEBUG=false). Use two different values:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dummy-secret-key-change-in-production
JWT_SECRET=dummy-jwt-secret-change-in-production
JWT_EXPIRES_HOURS=168

CORS_ORIGINS=http://localhost:8010,http://127.0.0.1:8010,http://localhost:5173,http://127.0.0.1:5173,https://localhost,https://127.0.0.1,https://localhost:8443

INVITE_EXPIRES_DAYS=14

# Optional: S3 / R2 photo storage (leave blank for local uploads/)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=dummy-access-key
S3_SECRET_ACCESS_KEY=dummy-secret-key
S3_BUCKET=peoplegraph-photos-dev
S3_REGION=auto
S3_PUBLIC_BASE_URL=
S3_PUBLIC_ACL=false

# Optional: SMTP invite email
# Leave SMTP_HOST empty to log invites to the server console.
# Dummy FROM/USER values (example.com) are ignored even if HOST is set.
# Mailpit: docker compose --profile mail up -d mailpit
#   SMTP_HOST=localhost SMTP_PORT=1025 SMTP_FROM=PeopleGraph <invites@localhost> SMTP_USE_TLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=dummy@example.com
SMTP_PASSWORD=dummy-smtp-password
SMTP_FROM=PeopleGraph <noreply@example.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
