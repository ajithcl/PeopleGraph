# PeopleGraph environment template — copy to .env and fill in values

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

PORT=8010
FLASK_DEBUG=false
APP_PUBLIC_URL=http://localhost:8010

# Required in production — use long random strings
SECRET_KEY=change-me-long-random
JWT_SECRET=change-me-another-long-random
JWT_EXPIRES_HOURS=168

CORS_ORIGINS=http://localhost:8010,http://127.0.0.1:8010

INVITE_EXPIRES_DAYS=14

# --- Phase 4: S3-compatible photo storage (optional) ---
# Leave blank to keep using local uploads/photos/
# Cloudflare R2 example:
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=peoplegraph-photos
# S3_REGION=auto
# S3_PUBLIC_BASE_URL=https://photos.yourdomain.com
# S3_PUBLIC_ACL=false

S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
S3_PUBLIC_BASE_URL=
S3_PUBLIC_ACL=false

# --- Phase 4: SMTP invite email (optional) ---
# Leave blank to log invite emails to the server console
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=PeopleGraph <noreply@yourdomain.com>
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
